{
  "name": "@mesagroup/mesa-cli",
  "version": "1.3.0",
  "description": "CLI tool for scaffolding MESAPPA plugin projects (on-prem and SaaS)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "mesa": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "xo",
    "release": "tsup --config tsup.config.ts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\"",
    "test": "vitest",
    "test:watch": "vitest watch"
  },
  "keywords": [
    "mesa",
    "mesappa",
    "cli",
    "scaffold",
    "plugin",
    "angular",
    "express",
    "typescript",
    "aspire"
  ],
  "author": "MESA Group",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/mesagroup/mesa-cli.git"
  },
  "homepage": "https://github.com/mesagroup/mesa-cli#readme",
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.9.0",
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.31.0",
    "@typescript-eslint/parser": "^8.31.0",
    "prettier": "^3.5.3",
    "tsup": "^8.4.0",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2",
    "xo": "^0.60.0",
    "zx": "^8.5.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.3.2",
    "chalk": "^5.4.1",
    "diff": "^7.0.0",
    "dotenv": "^16.5.0",
    "fast-deep-equal": "^3.1.3",
    "figures": "^6.1.0",
    "js-yaml": "^4.1.0",
    "marked-terminal": "^7.3.0",
    "meow": "^13.2.0",
    "open": "^10.1.1",
    "shell-quote": "^1.8.2",
    "strip-ansi": "^7.1.0",
    "zod": "^3.24.3"
  }
}
